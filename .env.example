# Hugging Face Authentication Token (required for gated medical models like MedGemma)
HF_TOKEN=your_huggingface_token_here

# MLflow Tracking URI
MLFLOW_TRACKING_URI=./experiments/mlruns

# CUDA Hardware Configuration
CUDA_VISIBLE_DEVICES=0

# MedFusion-RAFT System Settings
MEDFUSION_LOG_LEVEL=INFO
MEDFUSION_CONFIG_DIR=./configs
MEDFUSION_DATA_DIR=./data
MEDFUSION_EXPERIMENT_DIR=./experiments
MEDFUSION_MODEL_CACHE_DIR=./models

# Logging format (set to "true" for JSON structured logs)
MEDFUSION_LOG_JSON=false
